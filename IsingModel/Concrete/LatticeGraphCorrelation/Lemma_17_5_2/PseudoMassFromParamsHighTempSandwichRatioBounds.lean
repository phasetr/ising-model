/-!
# Concrete pseudo-mass high-temperature sandwich: ratio-bound auto-active wrappers (GJ Lemma 17.5.2)

This module holds the compact-ratio-bound wrappers of the concrete
`pseudoMassFromParamsAtPair` high-temperature sandwich package whose active-range
premise is supplied automatically from the high-temperature interval inclusion:
the upper-bound, sandwich, and capstone forms on the ambient interval and on the
self interval `[β₁, β₂]`.

The shared active-range hub lives in
`PseudoMassFromParamsHighTempSandwichActiveRange`, imported here.  The umbrella
module `PseudoMassFromParamsHighTempSandwich` re-exports this file so downstream
consumers keep importing the original path unchanged.
-/

namespace IsingModel

open Set

namespace Ambient

/-- **GJ §17.5 Lemma 17.5.2 concrete compact-ratio upper bound with automatic
active range**: the high-temperature interval inclusion supplies the
active-range hypothesis for the concrete pseudo-mass profile, while the
derivative-limit input remains explicit. -/
theorem lemma_17_5_2_upper_bound_of_concrete_pseudoMass_compact_ratio_bounds_auto_active
    {d α : ℕ} (hα : 1 ≤ α) (hαd : 2 * α > d) (hd : 1 ≤ d)
    (Λ : Ambient.Exhaustion (Fin d → ℤ))
    {J : ℝ} (hJ_pos : 0 < J)
    {x z : Fin d → ℤ} (hxz : x ≠ z)
    {β₁ β₂ a b : ℝ} (hβ₁₂ : β₁ ≤ β₂)
    (hIcc :
      Set.Icc β₁ β₂ ⊆ Set.Ioo (0 : ℝ) (1 / (J * ↑(2 * d))))
    (ha : 0 < a) (hab : a ≤ b) (hlt : b * J * ↑(2 * d) < 1)
    (hβ_mem : ∀ β ∈ Set.Icc β₁ β₂, β ∈ Set.Icc a b)
    {rho : ℝ} (hrho : 0 < rho) (g' : ℝ → ℝ)
    (hderiv_lim :
      TendstoLocallyUniformlyOn
        (fun n β =>
          deriv (fun β' =>
            Ambient.correlationAlongExhaustion (IsingModel.latticeGraph d) Λ
              (⟨J, 0, β'⟩ : IsingParams ℝ) {x, z} n) β)
        g' Filter.atTop (Set.Ioo (0 : ℝ) (1 / (J * ↑(2 * d))))) :
    ∃ K : ℝ, 0 < K ∧
      (∀ x' y' : Fin d → ℤ,
        ∑' w : Fin d → ℤ,
            (1 + latticeDistance d x' w : ℝ) ^ (-(α : ℝ)) *
            (1 + latticeDistance d y' w : ℝ) ^ (-(α : ℝ)) ≤ K) ∧
      Lemma_17_5_2_UpperBound hα hrho Λ J β₂ x z
        (ENNReal.ofReal (((2 * α + 1 : ℕ) : ℝ) * K / rho)) := by
  exact
    lemma_17_5_2_upper_bound_of_concrete_pseudoMass_compact_ratio_bounds
      (d := d) (α := α) (Λ := Λ) (J := J) (x := x) (z := z)
      (β₁ := β₁) (β₂ := β₂) (a := a) (b := b) (rho := rho)
      hα hαd hd hJ_pos hxz hβ₁₂ hIcc ha hab hlt hβ_mem hrho g'
      (lemma_17_5_2_active_range_on_Icc_of_high_temp_pair Λ hJ_pos hxz hIcc)
      hderiv_lim

