    simpa [u] using rayExitIndex_ltFrontierUpperSite_eq a b hgap hnon
  have hgtCU : rayExitIndex F u.1 u.2 < rayExitIndex F c.1 c.2 := by
    rw [hidxU]
    dsimp [c] at hresGap ⊢
    omega
  rcases hstrip with ⟨m, hm, hout⟩
  exact
