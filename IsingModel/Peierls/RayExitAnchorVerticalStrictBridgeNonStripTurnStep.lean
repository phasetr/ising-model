      dsimp [c, u]
      exact rayExitVerticalStrictLtFrontierUpperSite_eq_frontierSite_add_e1
        a b hup hgap hnon
    have hupPQ : q.1 = p.1 + unitVec2 1 := by
      dsimp [p, q]
      exact rayExitVerticalStrictLtFrontierUpperSite_eq_frontierSite_add_e1
        c u hupCU hgapCU hnonRes
    have hupRS : s.1 = r.1 + unitVec2 1 := by
