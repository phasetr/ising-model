/-- Non-strip genuine-gap residual-index ordered strict frontier-upper-site endpoint
upper-prefix-site form, parameterized by the endpoint residual frontier-site comparison and
the straight-strip predicate left explicit. -/
def
RayExitVerticalStrictLtFUSARLtUSResUpperResidualLtNSFrUpperResidualLtNSFrUpperResLtNSFrSRLNSUpQIC
    (F : Finset (Fin 2 → ℤ)) (cmp : ℕ → ℕ → Prop)
    (strip : {x : Fin 2 → ℤ // x ∈ F} → {x : Fin 2 → ℤ // x ∈ F} → Prop) :
    Prop :=
  ∀ a b : {x : Fin 2 → ℤ // x ∈ F},
    (hup : b.1 = a.1 + unitVec2 1) →
      (hlt : rayExitIndex F a.1 a.2 < rayExitIndex F b.1 b.2) →
        (hgap : rayExitIndex F a.1 a.2 + 1 < rayExitIndex F b.1 b.2) →
