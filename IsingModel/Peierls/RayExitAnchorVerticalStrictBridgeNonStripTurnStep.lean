                        (hnonRS : ¬ RayExitVerticalStrictLtGapStrip F
                          (rayExitVerticalStrictLtFrontierSite p q hgapPQ hnonPQ)
                          (rayExitVerticalStrictLtFrontierUpperSite p q hgapPQ hnonPQ)) →
